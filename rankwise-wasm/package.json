{
  "name": "rankwise",
  "version": "0.1.0",
  "private": true,
  "description": "Lane-parallel SIMD order statistics in WebAssembly: medians, quantiles, ranks and sigma clipping along one axis, identical to NumPy, SciPy and astropy.",
  "type": "module",
  "main": "./js/rankwise.js",
  "types": "./js/rankwise.d.ts",
  "exports": {
    ".": {
      "types": "./js/rankwise.d.ts",
      "default": "./js/rankwise.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "js/",
    "dist/*.wasm",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "fixtures": "python3 test/make_fixtures.py",
    "test": "node test/api.test.mjs && node test/conformance.test.mjs",
    "test:bun": "bun test/api.test.mjs && bun test/conformance.test.mjs",
    "bench": "node bench/bench.mjs"
  },
  "keywords": [
    "median",
    "quantile",
    "percentile",
    "sigma-clipping",
    "simd",
    "webassembly",
    "wasm",
    "statistics",
    "image-stacking",
    "astronomy"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/brannondorsey/rankwise",
    "directory": "rankwise-wasm"
  },
  "devDependencies": {
    "d3-array": "^3.2.4"
  }
}
